# ─── Database ───────────────────────────────────────────────
DATABASE_URL=postgres://postgres:postgres@postgres:5432/webhook_processor
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=webhook_processor

# ─── Redis ──────────────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379

# ─── Backend ────────────────────────────────────────────────
BACKEND_PORT=3001
NODE_ENV=development

# ─── Queue / Retry ──────────────────────────────────────────
MAX_ATTEMPTS=5
RETRY_DELAY_MS=1000

# ─── Recovery ───────────────────────────────────────────────
# Events stuck in PROCESSING longer than this (seconds) are considered stale
PROCESSING_STALE_TIMEOUT_SECONDS=30

# ─── Worker ─────────────────────────────────────────────────
# Overridden per-container in docker-compose.yml
WORKER_ID=worker-local

# ─── Outbox ─────────────────────────────────────────────────
OUTBOX_POLL_INTERVAL_MS=1000

# ─── Frontend ───────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:3001
